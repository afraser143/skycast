# Sign-in password for the app (required on Vercel; leave unset locally to skip the login screen)
APP_PASSWORD=
# Long random string that signs the login cookie (required on Vercel), e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
SESSION_SECRET=
# Postgres URL (Neon on Vercel). Unset locally to use SQLite in ./skycast.db
DATABASE_URL=
# Enables the AI-written reading. Without it, a reading is built from the same facts by a template.
ANTHROPIC_API_KEY=
